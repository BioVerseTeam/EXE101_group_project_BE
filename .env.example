# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env

# Chỉ cần đổi dòng này: local | supabase
# Cả hai block DB bên dưới để mở cùng lúc được vì tên biến khác nhau.
SPRING_PROFILES_ACTIVE=supabase

# OpenRouter — cổng gọi AI. Không liên quan database.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# JWT — đổi secret khi deploy (tối thiểu 32 ký tự)
JWT_SECRET=BioverseJwtSecretKeyThatIsAtLeastThirtyTwoCharsLong!
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Redis — local IDE: docker compose up -d (localhost:6380)
# Prod Docker: docker-compose.prod.yml tự set REDIS_HOST=bioverse-redis, REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=123456
REDIS_SSL=false
REDIS_TIMEOUT=2s

SEED_ENABLED=true

# Mail — OTP đăng ký / quên mật khẩu (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your-gmail@gmail.com
MAIL_FROM_NAME=Bioverse
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# local — khớp docker-compose.yml (docker compose up -d)
# -----------------------------------------------------------------------------
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5434
LOCAL_DB_NAME=bioverse
LOCAL_DB_USERNAME=bioverse
LOCAL_DB_PASSWORD=123456
LOCAL_DB_SSLMODE=disable
LOCAL_DB_POOL_SIZE=10

# -----------------------------------------------------------------------------
# supabase — Session pooler (port 5432), KHÔNG dùng Transaction pooler (6543)
# Dashboard → Project Settings → Database
# -----------------------------------------------------------------------------
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_POOL_SIZE=5
# Tùy chọn: URI đầy đủ cho ./scripts/push-db-to-supabase.sh
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
