# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env

# Chỉ cần đổi dòng này: local | supabase
# Cả hai block DB bên dưới để mở cùng lúc được vì tên biến khác nhau.
SPRING_PROFILES_ACTIVE=supabase

# OpenRouter — cổng gọi AI. Không liên quan database.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# -----------------------------------------------------------------------------
# local — khớp docker-compose.yml (docker compose up -d)
# -----------------------------------------------------------------------------
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5434
LOCAL_DB_NAME=bioverse
LOCAL_DB_USERNAME=bioverse
LOCAL_DB_PASSWORD=123456
LOCAL_DB_SSLMODE=disable
LOCAL_DB_POOL_SIZE=10

# -----------------------------------------------------------------------------
# supabase — Session pooler (port 5432), KHÔNG dùng Transaction pooler (6543)
# Dashboard → Project Settings → Database
# -----------------------------------------------------------------------------
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_POOL_SIZE=5
# Tùy chọn: URI đầy đủ cho ./scripts/push-db-to-supabase.sh
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
