# Copy thành .env trên server rồi điền giá trị thật.
# Redis đi cùng stack Docker — KHÔNG điền REDIS_HOST=localhost.
# docker-compose.prod.yml tự trỏ Redis tới service bioverse-redis.

SPRING_PROFILES_ACTIVE=supabase
SERVER_PORT=8088
SEED_ENABLED=false

# Image đã push lên registry (server pull image này)
BACKEND_IMAGE=YOUR_REGISTRY/bioverse-be:latest

JWT_SECRET=doi-secret-dai-it-nhat-32-ky-tu-khi-len-prod
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your-gmail@gmail.com
MAIL_FROM_NAME=Bioverse

# Redis trong Docker network — BẮT BUỘC, backend và redis dùng cùng một password
REDIS_PASSWORD=doi-password-redis-khi-len-prod
REDIS_USERNAME=
REDIS_TIMEOUT=2s

# Firebase key đặt cạnh compose, hoặc đổi path
FIREBASE_KEY_PATH=./firebase/serviceAccountKey.json

SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_POOL_SIZE=5
