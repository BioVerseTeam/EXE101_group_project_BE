# Copy thành .env trên server rồi điền giá trị thật.
# Đặt tại /projects/bioverse/.env — owner user Linux `bioverse` (không root).
# Redis đi cùng stack Docker — KHÔNG điền REDIS_HOST=localhost.
# docker-compose.prod.yml tự trỏ Redis tới service bioverse-redis và SERVER_PORT=8088.

SPRING_PROFILES_ACTIVE=supabase
SEED_ENABLED=false

# Host port map ra VPS (cloudflared trỏ tới đây). Trong container luôn 8088.
HOST_PORT=8088

# Image trên Harbor (CI set BACKEND_IMAGE + IMAGE_TAG khi deploy)
BACKEND_IMAGE=registry.eraidev.id.vn/bioverse/bioverse-backend
IMAGE_TAG=latest

# FE domain — CORS (comma-separated nếu nhiều origin).
# Cùng origin qua Cloudflare Tunnel vẫn giữ được; cần nếu FE origin khác.
CORS_ALLOWED_ORIGINS=https://bioverse.eraidev.id.vn

JWT_SECRET=doi-secret-dai-it-nhat-32-ky-tu-khi-len-prod
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Cloudflare R2 — backend proxy 3D models cho FE
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bio3d-models

# Brevo SMTP — Settings → SMTP & API.
# Prod: authenticate domain eraidev.id.vn (hoặc bioverse.eraidev.id.vn) trên Brevo
# rồi MAIL_FROM phải thuộc domain đó (vd noreply@...). Không dùng @gmail.com trên prod.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login
MAIL_PASSWORD=xsmtpsib-your-brevo-smtp-key
MAIL_FROM=noreply@eraidev.id.vn
MAIL_FROM_NAME=BioVerse
APP_PUBLIC_URL=https://bioverse.eraidev.id.vn

# Redis trong Docker network — BẮT BUỘC, backend và redis dùng cùng một password
REDIS_PASSWORD=doi-password-redis-khi-len-prod
REDIS_USERNAME=
REDIS_TIMEOUT=2s

# Firebase key đặt cạnh compose, hoặc đổi path
FIREBASE_KEY_PATH=./firebase/serviceAccountKey.json

SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_POOL_SIZE=5
