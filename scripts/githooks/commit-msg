#!/bin/sh
# Strip Cursor / AI attribution so GitHub does not count the agent as a contributor.
file=$1
tmp="${file}.tmp"

grep -v -E '^(Co-authored-by:[[:space:]]*Cursor|Made-with:[[:space:]]*Cursor|Made with Cursor)' "$file" > "$tmp"

awk '
  { lines[NR] = $0 }
  END {
    last = NR
    while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
    for (i = 1; i <= last; i++) print lines[i]
  }
' "$tmp" > "$file"

rm -f "$tmp"
exit 0
